```bash
# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=/data/checks.db

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_minimum_32_chars_random_string_here

# ── Evolution API (WhatsApp) ─────────────────────────────────────────────────
# After deploy: curl http://localhost:8080/instance/create -H "apikey: $EVOLUTION_API_KEY"
# Then scan QR at: http://<your-vps>:8080/instance/qrcode/<instance-name>
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=CHANGE_ME_evolution_api_secret_key
EVOLUTION_INSTANCE=pingboard-prod

# ── Health Check Engine ───────────────────────────────────────────────────────
CHECK_TIMEOUT_MS=5000
CHECK_MAX_CONCURRENT=50

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
```